# Copy to .env and adjust: cp .env.example .env
# Never commit .env. Docker Compose reads it automatically.
# NOTE: a variable already set in your shell overrides the same variable in .env
# (for example a leftover DB_USER in your shell wins over DB_USER below).
# The Spring profile is not set here: prod is the default, and docker compose runs the app with prod.
# For local development use: ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev

# PostgreSQL database name
DB_NAME=selfhostcrm

# PostgreSQL user (REQUIRED; used by the db container and the app)
DB_USER=selfhostcrm

# PostgreSQL password (REQUIRED, no default). At least 12 characters and not one of
# change-me / selfhostcrm / postgres / password: the app refuses to start otherwise.
# Generate one with: openssl rand -base64 24
DB_PASSWORD=

# PostgreSQL host port published by Docker Compose (bound to 127.0.0.1 only).
# Also the port a locally run app (./mvnw spring-boot:run) connects to.
DB_PORT=5432

# PostgreSQL host used by a locally run app (not by docker compose, which uses the db service)
DB_HOST=localhost

# HTTP port the application listens on (and publishes in docker compose)
SERVER_PORT=8080

# HS256 signing secret for API JWTs. REQUIRED in prod, at least 32 bytes.
# Left empty on purpose: the app (and docker compose) refuse to start until you set it.
# (In the dev profile an unset secret gets a random value per run.)
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Access token lifetime (default 15m) and refresh token lifetime (default 7d)
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Set true when served over HTTPS (behind a reverse proxy) so the session cookie gets the Secure flag
SESSION_COOKIE_SECURE=false

# Login lockout: failed attempts before a temporary lock, and lock duration
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m

# Delete expired refresh tokens periodically (on by default in prod) and how often
REFRESH_TOKEN_CLEANUP_ENABLED=true
REFRESH_TOKEN_CLEANUP_INTERVAL=1h
